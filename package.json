{
  "name": "astro-og-kit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w astro-og-kit",
    "check": "npm run check -w astro-og-kit",
    "test": "npm test -w astro-og-kit",
    "format": "prettier --write .",
    "lint": "prettier --check . && npm run check",
    "docs:check": "node scripts/sync-package-readme.mjs --check",
    "docs:images": "npm run build && node scripts/readme-images.mjs",
    "docs:readme": "node scripts/sync-package-readme.mjs",
    "examples": "npm run build && npm run build -w example-backdrop -w example-editorial -w example-custom",
    "test:pnpm-bundle": "npm run build && node scripts/pnpm-bundle-fixture.mjs",
    "verify": "npm run lint && npm test && npm run docs:check",
    "changeset": "changeset",
    "release": "node scripts/guard-0x-version.mjs && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
