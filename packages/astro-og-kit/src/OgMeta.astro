---
import type { Og, OgMetaInput } from 'astro-og-kit'

type Props = Omit<OgMetaInput, 'site' | 'url'> & { og: Og }

const { og, ...input } = Astro.props
const deployBase = import.meta.env.BASE_URL
const tags = og.meta({
  ...input,
  image: input.image ?? new URL(og.path(Astro.url.pathname, deployBase), Astro.site ?? Astro.url).toString(),
  site: Astro.site,
  url: Astro.url,
})
---

{tags.map((tag) => <meta {...tag} />)}
